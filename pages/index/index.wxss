.page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000;
  overflow: hidden;
}

.camera {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 相机不可用占位 */
.camera-fallback {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #101014 0%, #1c1c22 100%);
}
.fallback-icon { font-size: 96rpx; margin-bottom: 24rpx; }
.fallback-text {
  color: #9a9aa0;
  font-size: 28rpx;
  text-align: center;
  white-space: pre-line;
  margin-bottom: 40rpx;
}
.fallback-btn { padding: 0 48rpx; }

/* 顶部环境栏 */
.env-bar {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  box-sizing: border-box;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 16rpx;
  background: linear-gradient(180deg, rgba(0,0,0,0.6) 0%, rgba(0,0,0,0) 100%);
  z-index: 10;
}
.env-main {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}
.env-sub {
  display: block;
  font-size: 22rpx;
  color: #f5c542;
  margin-top: 4rpx;
}

/* 横幅提示 */
.banner {
  position: absolute;
  top: 180rpx;
  left: 32rpx;
  right: 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: rgba(18, 18, 20, 0.78);
  border-radius: 16rpx;
  z-index: 11;
}
.banner-accent { background: rgba(245, 197, 66, 0.16); }
.banner-text { flex: 1; font-size: 24rpx; color: #e8e8e8; }
.banner-accent .banner-text { color: #f5c542; }
.banner-close {
  padding: 0 8rpx 0 24rpx;
  color: #f5c542;
  font-size: 28rpx;
}

/* 右侧操作栏 */
.side-bar {
  position: absolute;
  right: 20rpx;
  bottom: 360rpx;
  display: flex;
  flex-direction: column;
  gap: 36rpx;
  z-index: 10;
}
.side-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 96rpx;
}
.side-icon {
  width: 88rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 40rpx;
  background: rgba(18, 18, 20, 0.72);
  border-radius: 50%;
}
.side-btn-active .side-icon {
  background: rgba(245, 197, 66, 0.9);
}
.side-label {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #c9c9cf;
}
.side-btn-active .side-label { color: #f5c542; }

/* 底部区域 */
.bottom-area {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 24rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}

/* 快门按钮 */
.shutter {
  margin-bottom: 28rpx;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.shutter-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
}
.shutter-core {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
}
.shutter:active .shutter-core { background: #c9c9cf; }

/* 悬浮参数栏 */
.param-bar {
  width: 100%;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 24rpx 12rpx;
}
.param-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.param-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  font-family: 'SF Mono', Menlo, Consolas, monospace;
}
.param-label {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #9a9aa0;
}
.param-divider {
  width: 2rpx;
  height: 48rpx;
  background: rgba(255, 255, 255, 0.14);
}
.param-hint {
  margin-top: 14rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.4);
}
