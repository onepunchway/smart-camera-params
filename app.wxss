/* 全局样式：深色相机风 */
page {
  background: #000;
  color: #fff;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* 半透明悬浮面板 */
.panel {
  background: rgba(18, 18, 20, 0.72);
  border-radius: 20rpx;
  backdrop-filter: blur(10px);
}

.panel-light {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
}

/* 通用文字 */
.text-main { color: #ffffff; }
.text-sub { color: #9a9aa0; font-size: 24rpx; }
.text-accent { color: #f5c542; }
.text-warn { color: #ff7875; font-size: 24rpx; }

/* 通用按钮 */
.btn-primary {
  background: #f5c542;
  color: #1a1a1a;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}
.btn-primary::after { border: none; }

.btn-ghost {
  background: rgba(255, 255, 255, 0.1);
  color: #fff;
  border-radius: 44rpx;
  font-size: 28rpx;
  border: none;
}
.btn-ghost::after { border: none; }

.btn-danger-text {
  color: #ff7875;
  background: transparent;
  font-size: 26rpx;
  border: none;
  padding: 0 16rpx;
}
.btn-danger-text::after { border: none; }

/* 列表卡片 */
.card {
  background: #161618;
  border-radius: 20rpx;
  padding: 28rpx;
  margin: 0 24rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.card-sub {
  font-size: 24rpx;
  color: #9a9aa0;
  margin-top: 8rpx;
}

.empty-tip {
  text-align: center;
  color: #6b6b70;
  padding: 120rpx 40rpx;
  font-size: 26rpx;
}
